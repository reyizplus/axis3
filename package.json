{
  "name": "axis3-app",
  "version": "0.1.0",
  "private": true,
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all",
      "last 2 versions",
      "not IE 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:iyzico": "node --env-file=.env.local scripts/iyzico-smoke.mjs",
    "docker:dev": "docker-compose up app postgres redis",
    "docker:dev:build": "docker-compose build app && docker-compose up app postgres redis",
    "docker:prod": "docker-compose --profile production up app-prod postgres redis",
    "docker:prod:build": "docker-compose --profile production build app-prod && docker-compose --profile production up app-prod postgres redis",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "docker:logs": "docker-compose logs -f app",
    "docker:shell": "docker-compose exec app sh",
    "docker:db": "docker-compose exec postgres psql -U axis3_user -d axis3_dev",
    "docker:redis": "docker-compose exec redis redis-cli"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/body": "^0.3.0",
    "@react-email/button": "^0.2.1",
    "@react-email/components": "^1.0.12",
    "@react-email/container": "^0.0.16",
    "@react-email/head": "^0.0.13",
    "@react-email/hr": "^0.0.12",
    "@react-email/html": "^0.0.12",
    "@react-email/render": "^2.0.7",
    "@react-email/section": "^0.0.17",
    "@react-email/text": "^0.1.6",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3",
    "@tiptap/extension-code-block-lowlight": "^3.22.4",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@types/speakeasy": "^2.0.10",
    "@types/three": "^0.160.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^3.16.0",
    "iyzipay": "^2.0.67",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.4",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.2.3",
    "react-email": "^6.0.0",
    "react-hook-form": "^7.72.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.1",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.160.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
