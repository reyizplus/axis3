# =============================================================================
# AXIS3 - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Command: cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (found in Project Settings > API)
# WARNING: Keep this secret! Never expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Database (Local PostgreSQL for development)
# -----------------------------------------------------------------------------
# Connection string for direct PostgreSQL access (used by pg library)
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/axis3_db

# -----------------------------------------------------------------------------
# Redis (Local cache for development)
# -----------------------------------------------------------------------------
# Connection string for Redis (used by ioredis)
REDIS_URL=redis://redis:6379

# Rate limiting (auth, contact, payment, upload, admin) sunucu belleğinde
# tutulur; harici bir Redis/Upstash kurulumu gerekmez.

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Base URL for the application (used for redirects and email links)
# Development: http://localhost:3000
# Production: https://axis3.com.tr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site URL (used for SEO, sitemap, robots.txt, Open Graph)
# Development: http://localhost:3000
# Production: https://axis3.com.tr
# IMPORTANT: Must match your actual domain in production!
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL for callbacks and redirects
# Development: http://localhost:3000
# Production: https://axis3.com.tr
NEXT_PUBLIC_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Email Configuration (Resend)
# -----------------------------------------------------------------------------
# Resend API key for sending transactional emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here

# Email address to send emails from (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@axis3.com.tr

# Sender display name
RESEND_FROM_NAME=AXIS3

# Optional Reply-To for informational mails (welcome, contact notifications).
# Security mails (password reset, verification codes) and order mails omit the
# header, so replies go back to the no-reply sender.
# Falls back to ADMIN_NOTIFICATION_EMAIL, then destek@axis3.com.tr.
RESEND_REPLY_TO=destek@axis3.com.tr

# -----------------------------------------------------------------------------
# Payment Gateway (iyzico)
# -----------------------------------------------------------------------------
# iyzico API key
IYZICO_API_KEY=your-iyzico-api-key

# iyzico secret key
IYZICO_SECRET_KEY=your-iyzico-secret-key

# iyzico base URL
# Development/Sandbox: https://sandbox-api.iyzipay.com
# Production: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Strict IP allowlist for the payment callback.
# Leave unset/false: iyzico's Checkout Form posts the callback from the buyer's
# browser, so an allowlist blocks every real payment. Enable only if you switch
# to a server-to-server iyzico notification.
IYZICO_STRICT_IP_CHECK=false

# -----------------------------------------------------------------------------
# Slicing (G-Code analysis)
# -----------------------------------------------------------------------------
# PrusaSlicer sidecar servisinin adresi. Docker Compose icinde servis adi
# "slicer"dir ve host'a port acilmaz; yalnizca ic agdan erisilir.
SLICER_URL=http://slicer:8000

# Uygulama ile sidecar arasindaki paylasilan gizli anahtar (x-slicer-token).
# Uretimde mutlaka degistirin; bos birakilirsa kimlik dogrulama kapanir.
SLICER_TOKEN=dev-token

# Dilimlemeyi acan kill switch. Yalnizca acikca "false" verilirse kapanir.
# Kapaliyken fiyat hacim tahmininden hesaplanir ve arayuzde "tahmini" olarak
# etiketlenir. Dikkat: PRICING_REQUIRE_SLICING=true iken kapatmak tum siparisleri
# 503 ile bloklar.
SLICING_ENABLED=true

# true ise siparis, secilen profil icin gercek dilimleme dogrulanmadan
# olusturulmaz. Dilimleyici kapaliyken siparis 503 ile reddedilir (K1 karari).
PRICING_REQUIRE_SLICING=true

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Maximum file size for STL uploads (in bytes)
# Default: 104857600 (100MB)
NEXT_PUBLIC_MAX_FILE_SIZE=104857600

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable guest upload feature (allows non-authenticated users to upload files)
NEXT_PUBLIC_ENABLE_GUEST_UPLOAD=true

# Enable blog system
NEXT_PUBLIC_ENABLE_BLOG=true

# -----------------------------------------------------------------------------
# Security & Rate Limiting
# -----------------------------------------------------------------------------
# Maximum number of requests allowed per time window
NEXT_PUBLIC_RATE_LIMIT_REQUESTS=100

# Time window for rate limiting (in milliseconds)
# Default: 900000 (15 minutes)
NEXT_PUBLIC_RATE_LIMIT_WINDOW=900000

# -----------------------------------------------------------------------------
# Admin Configuration
# -----------------------------------------------------------------------------
# Admin email address (used for notifications and admin identification)
NEXT_PUBLIC_ADMIN_EMAIL=@axis3.com.tr

# Where contact-form notifications are delivered. Falls back to
# RESEND_REPLY_TO when unset.
ADMIN_NOTIFICATION_EMAIL=destek@axis3.com.tr

# Secret used to HMAC verification codes (registration / 2FA / e-mail
# verification) before they are stored. 32+ characters. Falls back to
# ENCRYPTION_KEY, then SUPABASE_SERVICE_ROLE_KEY when unset; production
# refuses to issue codes if no secret is available.
VERIFICATION_CODE_SECRET=

# -----------------------------------------------------------------------------
# Database Configuration (Docker Development Only)
# -----------------------------------------------------------------------------
# These are only needed if you're running Supabase locally with Docker
# For production, use Supabase Cloud and the SUPABASE_* variables above

# PostgreSQL password for local development
POSTGRES_PASSWORD=your-postgres-password

# PostgreSQL database name
POSTGRES_DB=axis3_db

# PostgreSQL user
POSTGRES_USER=postgres

# -----------------------------------------------------------------------------
# Optional: Analytics & Monitoring
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
# Get from: https://analytics.google.com/
# Leave empty to disable Google Analytics
# (Eski ad NEXT_PUBLIC_GA_ID de desteklenir)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google etiketi / Tag Manager kapsayıcı kimliği (örn. GTM-)
# Google Ads ve Analytics etiketleri bu kapsayıcı üzerinden yönetilir.
# Get from: https://tagmanager.google.com/
# Etiket ilk HTML'in <head> bölümünde yüklenir (Google doğrulaması için);
# Consent Mode sayesinde çerez onayı verilene kadar çerez yazmaz.
# Boş bırakılırsa yalnızca Google Ads kimliği varsa etiket basılır.
# DİKKAT: Aynı Google Ads dönüşüm etiketini kapsayıcı içine de eklemeyin,
# iki kez çalışır ve dönüşümler çift sayılır.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# Google Ads dönüşüm etiketi kimliği (örn. AW-)
# Google Ads > Araçlar > Dönüşümler > Etiket kurulumu ekranındaki kimlik.
# Etiket ilk HTML'in <head> bölümünde yüklenir (Google doğrulaması için),
# ancak Consent Mode sayesinde çerez onayı verilene kadar çerez yazmaz.
# Boş bırakılırsa Google Ads etiketi hiç basılmaz.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads dönüşüm etiketi "label" değeri (send_to = AW-.../label)
# Aynı ekrandaki `send_to` değerinin eğik çizgiden sonraki parçası.
# Boş bırakılırsa sipariş tamamlandı dönüşümü gönderilmez.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Sentry error tracking (optional)
# Get from: https://sentry.io/settings/{org}/projects/{project}/keys/
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Google Site Verification (for Search Console)
# Get from: https://search.google.com/search-console/
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Site Verification
# -----------------------------------------------------------------------------
# Yandex Webmaster verification ID
# Get from: https://webmaster.yandex.com/
NEXT_PUBLIC_YANDEX_VERIFICATION=a48d2ed707b0ab2d

# Bing Webmaster verification ID
# Get from: https://www.bing.com/webmasters/
NEXT_PUBLIC_BING_VERIFICATION=B1026C66750DB1E13944A3FE21B9F586


ENCRYPTION_KEY=your-encryption-key-here
VERIFICATION_CODE_SECRET=your-verification-code-secret-here

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. Never commit .env.local or .env files to version control
# 2. Keep SUPABASE_SERVICE_ROLE_KEY secret - it has admin privileges
# 3. Use different keys for development and production
# 4. For production deployment, set these variables in your hosting platform
#    (Vercel, Railway, etc.) environment variables section
# 5. iyzico: Use sandbox URL for development, production URL for live
# =============================================================================
